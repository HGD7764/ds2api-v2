{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "container",
      "functions": {
        "api/chat-stream.js": {
          "maxDuration": 300
        },
        "api/index.go": {
          "maxDuration": 300
        }
      },
      "bindings": [
        {
          "type": "service",
          "service": "webui",
          "format": "url",
          "env": "WEBUI_URL"
        }
      ]
    },
    "webui": {
      "root": "webui",
      "framework": "vite",
      "buildCommand": "npm ci && npm run build",
      "outputDirectory": "../static"
    }
  },
  "rewrites": [
    {
      "source": "/v1/chat/completions",
      "has": [
        {
          "type": "query",
          "key": "__go"
        }
      ],
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/v1/chat/completions",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/login",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/verify",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/config",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/config/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/settings",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/settings/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/keys(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/accounts(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/queue/status",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/import",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/test",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/vercel/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/export",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/version",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/chat-history(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/proxies(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/dev/raw-samples/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/dev/captures(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/assets/(.*)",
      "destination": {
        "service": "webui"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "webui",
        "path": "/index.html"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "webui",
        "path": "/index.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "headers": [
    {
      "source": "/admin/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
